# ============================================================
# Biến môi trường của agent. Dùng: cp .env.example .env
# (.env nằm trong .gitignore — KHÔNG commit file .env, không ghi secret thật ở đây)
# ============================================================

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
# Số uvicorn worker trong Docker image
WEB_CONCURRENCY=2

# Security — đặt một chuỗi ngẫu nhiên dài, vd: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# Redis (docker-compose tự ghi đè thành redis://redis:6379/0)
REDIS_URL=redis://localhost:6379/0

# Rate limit: số request / 60 giây cho mỗi API key
RATE_LIMIT_PER_MINUTE=10

# Cost guard (USD)
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
